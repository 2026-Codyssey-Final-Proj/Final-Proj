{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-claude-main.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/block-dangerous-git.sh",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/require-tests-before-commit.sh",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-secrets.sh",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/block-merged-branch-push.sh",
            "if": "Bash(git *)"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(create|update)_event",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/calendar-owner-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/ask-calendar-invite.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-links.sh",
            "if": "Edit(**/*.md)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-skills.sh",
            "if": "Edit(**/SKILL.md)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-skills.sh",
            "if": "Write(**/SKILL.md)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-mermaid.sh",
            "if": "Edit(**/*.md)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-mermaid.sh",
            "if": "Write(**/*.md)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/unreviewed-commits.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/session-briefing.sh"
          }
        ]
      }
    ]
  }
}
