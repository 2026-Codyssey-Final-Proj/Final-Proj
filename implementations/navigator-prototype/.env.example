# 이 파일을 복사해 `.env`로 만들고 값을 채우세요: cp .env.example .env
# .env는 git에 올라가지 않습니다. 키는 각자 본인 것을 쓰고, 서로 공유하지 마세요.
ANTHROPIC_API_KEY=

# 코디세이 운영팀이 준 "중계 서버 가상 키"를 쓴다면 — 아래 두 줄의 # 를 지우고 운영팀 안내대로 채우세요.
# (공식 Anthropic 키라면 이 두 줄은 그대로 두세요. 주소를 바꾸면 호환 모드가 자동으로 켜집니다.)
# ANTHROPIC_BASE_URL=<운영팀이 알려 준 주소>
# NAV_MODEL=<운영팀이 알려 준 모델 이름>

# 이 키로 쓸 토큰 한도 — 80%에서 알려 주고 100%에서 멈춥니다. 정하지 않으면 막지 않아요.
# NAV_TOKEN_BUDGET=900000

# 용도별로 몫을 나눠 쓰기 — 규칙·프롬프트 40만 / 사용자 테스트 20만 / 리허설·녹화 20만 / 예비 20만(잠겨 있음)
# NAV_PLAN=default

# 아래는 바꾸고 싶을 때만 (기본값이 있어요)
# NAV_MODEL=claude-opus-5-5
# NAV_EFFORT=low
# NAV_MAX_TOKENS=2048
# NAV_FALLBACK=off
